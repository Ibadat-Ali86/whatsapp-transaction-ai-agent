# Copy to deploy/env/bot.env and chmod 600. Never commit bot.env.
WHATSAPP_ALLOWED_GROUP_JIDS=
# Optional private recipients for full Stripe candidate proof. Use only direct
# WhatsApp JIDs; never configure a group JID here.
PAYMENT_REVIEW_ADMIN_JIDS=
BOT_REPLY_ENABLED=true
BOT_REACTIONS_ENABLED=true
# Shows an intake acknowledgment while OCR/Stripe verification is running.
# This is only an acknowledgment, never a payment approval.
BOT_PROCESSING_REACTIONS_ENABLED=true
LOG_LEVEL=info
RESET_GROUP_SENDER_KEYS_ON_START=true
N8N_WEBHOOK_PATH=/webhook/whatsapp-screenshot
N8N_WEBHOOK_TOKEN=
N8N_HEALTH_TIMEOUT_MS=5000
# Must be longer than the 120s Stripe HTTP node timeout in the production n8n workflow.
N8N_TIMEOUT_MS=150000
N8N_RETRY_ATTEMPTS=2
STRIPE_VERIFICATION_ENABLED=true
BATCH_RECONCILIATION_ENABLED=true
BATCH_RECONCILIATION_WINDOW_MS=2500
BATCH_RECONCILIATION_MAX_ITEMS=8
PROCESSING_QUEUE_CONCURRENCY=1
PROCESSING_QUEUE_MAX_PENDING=200
PROCESSING_QUEUE_MAX_ATTEMPTS=4
PROCESSING_QUEUE_BACKOFF_BASE_MS=5000
PROCESSING_QUEUE_BACKOFF_MAX_MS=300000
PROCESSING_QUEUE_COOLDOWN_MS=250
