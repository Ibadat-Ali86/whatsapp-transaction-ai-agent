# Copy to deploy/env/ocr.env and chmod 600. Never commit ocr.env.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-1.5-flash
OCR_CONFIDENCE_THRESHOLD=0.85
MAX_IMAGE_SIZE_MB=10
LOG_LEVEL=INFO
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_SERVICE_TOKEN=
STRIPE_MODE=live
STRIPE_API_BASE_URL=https://api.stripe.com
# Use a Stripe API version that exposes Cash App transaction_id on Charge
# payment_method_details (2025-07-30.basil or newer). Leave blank only when
# the account default is confirmed to expose that field.
STRIPE_API_VERSION=
STRIPE_TIMEOUT_SECONDS=15
# Stripe dashboard/account timestamps are US Central in this deployment.
STRIPE_TIMEZONE=America/Chicago
STRIPE_SCREENSHOT_TIMEZONE=
STRIPE_MAX_PAGES=10
# Used only for exact-identifier and bounded date/lookback recovery after
# Stripe Search pagination. Keep finite for latency and rate-limit safety.
STRIPE_RECOVERY_MAX_PAGES=100
STRIPE_LOOKBACK_DAYS=90
STRIPE_ALLOWED_PAYMENT_METHOD_TYPE=cashapp
STRIPE_CACHE_TTL_SECONDS=10
STRIPE_CACHE_MAX_ENTRIES=512
STRIPE_REQUESTS_PER_SECOND=20
STRIPE_MAX_CONCURRENT_REQUESTS=5
STRIPE_RETRY_ATTEMPTS=2
STRIPE_BACKOFF_BASE_SECONDS=0.5
STRIPE_BACKOFF_MAX_SECONDS=8
