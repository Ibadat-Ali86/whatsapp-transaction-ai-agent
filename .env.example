# WhatsApp Transaction AI Agent — Environment Configuration Template
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# SECURITY: .env is git-ignored. Never commit real credentials.
# See docs/SECURITY.md and docs/ENVIRONMENT.md for full rules.

# ---------------------------------------------------------------------------
# AI Provider (Phase 1: groq | future: gemini)
# ---------------------------------------------------------------------------
AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b

GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# OCR Engine
# ---------------------------------------------------------------------------
OCR_CONFIDENCE_THRESHOLD=0.85
MAX_IMAGE_SIZE_MB=10.0

# ---------------------------------------------------------------------------
# OCR HTTP Service (Python FastAPI)
# ---------------------------------------------------------------------------
OCR_SERVICE_HOST=0.0.0.0
OCR_SERVICE_PORT=8000

# ---------------------------------------------------------------------------
# WhatsApp Bot (Node.js / Baileys)
# ---------------------------------------------------------------------------
# Comma-separated JIDs of the only WhatsApp groups the bot may process.
# Format: 1234567890-1234567890@g.us
# Leave empty to keep message processing disabled (fail-closed).
WHATSAPP_ALLOWED_GROUP_JIDS=
# Legacy single-group setting; merged into the allowlist if provided.
WHATSAPP_TEST_GROUP_JID=
OCR_SERVICE_URL=http://localhost:8000
OCR_TIMEOUT_MS=60000
BOT_REPLY_ENABLED=true
AUTH_DIR=auth
TEMP_DIR=tmp
REQUIRE_EMAIL_CAPTION=true

# ---------------------------------------------------------------------------
# n8n (Phase 2 — not required for Phase 1)
# ---------------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_PATH=/webhook/whatsapp-screenshot
N8N_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_TIMEOUT_MS=60000
N8N_RETRY_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Stripe (server-side test-mode verification)
# ---------------------------------------------------------------------------
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_SERVICE_TOKEN=
STRIPE_MODE=test
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_API_VERSION=
STRIPE_TIMEOUT_SECONDS=15
STRIPE_TIMEZONE=UTC
STRIPE_MAX_PAGES=10
STRIPE_ALLOWED_PAYMENT_METHOD_TYPE=cashapp

# ---------------------------------------------------------------------------
# Google Sheets (Phase 5 — not required for Phase 1)
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Telegram (Phase 7 — not required for Phase 1)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
