# WhatsApp Transaction AI Agent — Environment Configuration Template
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# SECURITY: .env is git-ignored. Never commit real credentials.
# See docs/SECURITY.md and docs/ENVIRONMENT.md for full rules.

# ---------------------------------------------------------------------------
# AI Provider (Phase 1: groq | future: gemini)
# ---------------------------------------------------------------------------
AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b

GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# OCR Engine
# ---------------------------------------------------------------------------
OCR_CONFIDENCE_THRESHOLD=0.85
MAX_IMAGE_SIZE_MB=10.0

# ---------------------------------------------------------------------------
# OCR HTTP Service (Python FastAPI)
# ---------------------------------------------------------------------------
OCR_SERVICE_HOST=0.0.0.0
OCR_SERVICE_PORT=8000

# ---------------------------------------------------------------------------
# WhatsApp Bot (Node.js / Baileys)
# ---------------------------------------------------------------------------
# Comma-separated JIDs of the only WhatsApp groups the bot may process.
# Format: 1234567890-1234567890@g.us
# Leave empty to keep message processing disabled (fail-closed).
WHATSAPP_ALLOWED_GROUP_JIDS=
# Legacy single-group setting; merged into the allowlist if provided.
WHATSAPP_TEST_GROUP_JID=
OCR_SERVICE_URL=http://localhost:8000
OCR_TIMEOUT_MS=60000
BOT_REPLY_ENABLED=true
BOT_REACTIONS_ENABLED=true
AUTH_DIR=auth
# Clear only persisted sender-key memory for allowlisted groups at startup so
# WhatsApp redistributes group encryption keys after a linked-device recovery.
RESET_GROUP_SENDER_KEYS_ON_START=true
TEMP_DIR=tmp
DUPLICATE_STORE_PATH=data/duplicate-store.json
DUPLICATE_RETENTION_DAYS=90
DUPLICATE_PHASH_MAX_DISTANCE=6
# Caption email is preferred evidence, but missing/incorrect captions are
# recovered from OCR evidence and a unique Stripe match when safe.
REQUIRE_EMAIL_CAPTION=false
# Durable local queue for screenshot jobs. Keep this path on persistent disk.
PROCESSING_QUEUE_PATH=data/processing-queue.json
PROCESSING_QUEUE_CONCURRENCY=1
PROCESSING_QUEUE_MAX_PENDING=200
PROCESSING_QUEUE_MAX_ATTEMPTS=4
PROCESSING_QUEUE_BACKOFF_BASE_MS=5000
PROCESSING_QUEUE_BACKOFF_MAX_MS=300000
PROCESSING_QUEUE_COOLDOWN_MS=250

# ---------------------------------------------------------------------------
# n8n (Phase 2 — not required for Phase 1)
# ---------------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_PATH=/webhook/whatsapp-screenshot
N8N_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_HEALTH_TIMEOUT_MS=5000
N8N_TIMEOUT_MS=60000
N8N_RETRY_ATTEMPTS=2
STRIPE_VERIFICATION_ENABLED=false

# ---------------------------------------------------------------------------
# Stripe (server-side read-only verification)
# ---------------------------------------------------------------------------
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_SERVICE_TOKEN=
# Must match the key mode: test or live. Keep test for development.
STRIPE_MODE=test
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_API_VERSION=
STRIPE_TIMEOUT_SECONDS=15
STRIPE_TIMEZONE=UTC
# Optional receipt-clock timezone, e.g. America/Chicago. Leave empty when
# groups may contain senders from different local time zones.
STRIPE_SCREENSHOT_TIMEZONE=
STRIPE_MAX_PAGES=10
STRIPE_LOOKBACK_DAYS=90
STRIPE_ALLOWED_PAYMENT_METHOD_TYPE=cashapp
# Shared per-process Stripe protections for concurrent groups.
STRIPE_CACHE_TTL_SECONDS=10
STRIPE_CACHE_MAX_ENTRIES=512
STRIPE_REQUESTS_PER_SECOND=20
STRIPE_MAX_CONCURRENT_REQUESTS=5
STRIPE_RETRY_ATTEMPTS=2
STRIPE_BACKOFF_BASE_SECONDS=0.5
STRIPE_BACKOFF_MAX_SECONDS=8

# ---------------------------------------------------------------------------
# Google Sheets (Phase 5 — not required for Phase 1)
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Telegram (Phase 7 — not required for Phase 1)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
